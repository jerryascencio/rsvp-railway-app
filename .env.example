# All optional — the app is configured through the /#/admin setup screen.

# Port the server listens on. Railway injects this automatically.
PORT=5000

# Where the SQLite database file lives.
# Local default: ./data.db
# Railway with a volume mounted at /data: DATABASE_PATH=/data/data.db
DATABASE_PATH=./data.db

# Secret used to sign admin session tokens.
# If unset, a random secret is generated on first start and stored in the database.
# Set this if you want sessions to survive a database reset.
SESSION_SECRET=

# NOTE: Gmail sender address, Gmail app password, notify email and the admin
# login are NOT env vars — you enter them once on the /#/admin setup screen.

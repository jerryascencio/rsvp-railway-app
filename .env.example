# All optional — the app is configured through the /#/admin setup screen.

# Port the server listens on. Railway injects this automatically.
PORT=5000

# Where the SQLite database file lives.
# Local default: ./data.db
# Railway with a volume mounted at /data: DATABASE_PATH=/data/data.db
DATABASE_PATH=./data.db

# Secret used to sign admin session tokens.
# If unset, a random secret is generated on first start and stored in the database.
# Set this if you want sessions to survive a database reset.
SESSION_SECRET=

# NOTE: Gmail sender address, Gmail app password, notify email and the admin
# login are NOT env vars — you enter them once on the /#/admin setup screen.

# --- Multi-event platform (phase 1) ---
# Deploy this as a SEPARATE Railway service with its own volume. Do not point
# www.leahaespinoza.com at it, and do not set these on the live Leah service.

# Stripe account: "RSVP Sites by Mission" (test mode for now).
# Paste that account's keys here when Jerry sends them. Price IDs are optional;
# without them Checkout uses inline price_data ($100 / +$25 / $250).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_DOMAIN=
STRIPE_PRICE_CUSTOM=

# Public URL of the platform service (checkout return links). If unset, the
# request host is used. Do not set this to https://www.leahaespinoza.com.
PUBLIC_PLATFORM_URL=

# Jerry's studio login. Created on boot when both are set (password min 8).
# Changing these later does not rotate an existing super-admin password.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Hostnames that should serve the original Leah event at `/`.
# Default: www.leahaespinoza.com,leahaespinoza.com
# Leave unset on the new platform service.
LEGACY_ROOT_HOSTS=

# Guest-search abuse limit per IP per event per minute. Default 30.
SEARCH_RATE_LIMIT=30

# Photo files. Default: a folder named uploads next to the SQLite file
# (on Railway, /data/uploads when DATABASE_PATH=/data/data.db).
UPLOAD_DIR=
